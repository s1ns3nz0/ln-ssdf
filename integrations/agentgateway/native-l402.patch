diff --git a/crates/agentgateway/src/http/l402.rs b/crates/agentgateway/src/http/l402.rs
new file mode 100644
index 0000000..069a7a1
--- /dev/null
+++ b/crates/agentgateway/src/http/l402.rs
@@ -0,0 +1,67 @@
+use ::http::{HeaderValue, header::HeaderName};
+
+use crate::http::{PolicyResponse, Request};
+use crate::store::RequestPolicyTrait;
+use crate::*;
+
+/// Route-local guard for an Aperture-compatible L402 backend.
+///
+/// This policy deliberately never parses, mints, logs, or persists an L402
+/// credential. The selected route backend remains responsible for returning
+/// `402 WWW-Authenticate` challenges and validating authorized retries.
+#[apply(schema!)]
+pub struct Policy {
+	/// Methods accepted by this paid route, for example `["GET"]`.
+	pub methods: Vec<Strng>,
+	/// Request paths must start with one of these prefixes.
+	pub path_prefixes: Vec<Strng>,
+}
+
+impl RequestPolicyTrait for Policy {
+	async fn apply(
+		&self,
+		_client: &crate::proxy::httpproxy::PolicyClient,
+		_log: &mut crate::telemetry::log::RequestLog,
+		req: &mut Request,
+	) -> Result<PolicyResponse, crate::proxy::ProxyResponse> {
+		if !self.allows(req.method().as_str(), req.uri().path()) {
+			return Err(crate::proxy::ProxyError::AuthorizationFailed.into());
+		}
+		let correlation = HeaderValue::from_str(&uuid::Uuid::new_v4().to_string())
+			.expect("UUID is a valid header value");
+		req.headers_mut().insert(
+			HeaderName::from_static("x-agentgateway-l402-correlation-id"),
+			correlation,
+		);
+		Ok(Default::default())
+	}
+}
+
+impl Policy {
+	fn allows(&self, method: &str, path: &str) -> bool {
+		self
+			.methods
+			.iter()
+			.any(|allowed| allowed.as_str() == method)
+			&& self
+				.path_prefixes
+				.iter()
+				.any(|prefix| path.starts_with(prefix.as_str()))
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn allows_only_configured_method_and_path_caveats() {
+		let policy = Policy {
+			methods: vec!["GET".into()],
+			path_prefixes: vec!["/ti/indicator/".into(), "/ti/report/".into()],
+		};
+		assert!(policy.allows("GET", "/ti/indicator/198.51.100.1"));
+		assert!(!policy.allows("POST", "/ti/indicator/198.51.100.1"));
+		assert!(!policy.allows("GET", "/ti/campaign/example"));
+	}
+}

